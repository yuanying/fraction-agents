{
  "mirrorDir": "/var/run/github-writer/mirror",
  "app": {
    "appId": "123456",
    "installationId": "12345678",
    "privateKeyFile": "/var/run/secrets/github-app/private-key.pem"
  },
  "repositories": [
    {
      "owner": "example-owner",
